NODE_ENV=development

# 构建时写入网页标题、浏览器标签页和 Open Graph 标题。
APP_TITLE=MixLink
# 应用内部显示名称；未设置时回退为 APP_TITLE 对应的默认名称。
APP_NAME=MixLink

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 可选的 telesrv 服务端点。host 留空时使用 Telegram 官方数据中心。
TELESRV_WEB_DC_HOST=
TELESRV_WEB_DC_PORT=443
# telesrv 使用的 WebSocket 协议：`ws` 或 `wss`。
TELESRV_WEB_DC_PROTOCOL=wss
# telesrv 在 MTProto 授权时提供的 RSA 参数，需同时配置以下字段。
TELESRV_RSA_FINGERPRINT=
TELESRV_RSA_MODULUS=
TELESRV_RSA_EXPONENT=65537
# 仅当 telesrv 支持 HTTP MTProto 传输时设置为 `1`。
TELESRV_ALLOW_HTTP_TRANSPORT=0
# 当 telesrv 的 auth key 与旧部署不兼容时修改此值。
TELESRV_INSTANCE_ID=

BASE_URL=https://web.mixlink.cc/
# 构建时页面公开描述，用于搜索引擎和社交分享卡片。
APP_DESCRIPTION=MixLink 是一个安全的私有即时通讯服务。
# 构建时 FAQ 按钮跳转地址。
FAQ_URL=https://mixlink.cc/faq
# 构建时隐私政策按钮跳转地址。
PRIVACY_URL=https://mixlink.cc/privacy
