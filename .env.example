NODE_ENV=development

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 可选的 telesrv 服务端点。host 留空时使用 Telegram 官方数据中心。
TELESRV_WEB_DC_HOST=
TELESRV_WEB_DC_PORT=443
# telesrv 使用的 WebSocket 协议：`ws` 或 `wss`。
TELESRV_WEB_DC_PROTOCOL=wss
# telesrv 在 MTProto 授权时提供的 RSA 参数，需同时配置以下字段。
TELESRV_RSA_FINGERPRINT=
TELESRV_RSA_MODULUS=
TELESRV_RSA_EXPONENT=65537
# 仅当 telesrv 支持 HTTP MTProto 传输时设置为 `1`。
TELESRV_ALLOW_HTTP_TRANSPORT=0
# 当 telesrv 的 auth key 与旧部署不兼容时修改此值。
TELESRV_INSTANCE_ID=

BASE_URL=https://web.telegram.org/a/
